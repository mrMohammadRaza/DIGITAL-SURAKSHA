# Digital Suraksha - Environment Configuration
# Node environment (development, test, production)
NODE_ENV=development

# Backend Server Configuration
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# For local zero-config development (SQLite):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Docker / Production / CI):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_suraksha?schema=public"

# Admin Authentication & Security
JWT_SECRET=super_secret_jwt_key_for_digital_suraksha_min_32_chars_long_2026!
JWT_EXPIRES_IN=1d
SESSION_SECRET=suraksha_session_secure_key_change_in_production_12345

# Initial Admin Credentials (Provisioned on first seed)
ADMIN_EMAIL=admin@suraksha.gov.in
ADMIN_PASSWORD=SurakshaAdmin2026!

# Frontend Public API URL
VITE_API_URL=http://localhost:5000/api/v1
